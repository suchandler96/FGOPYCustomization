+                print(datetime.datetime.now(), "try to avoid fuse with key press")
+                fgoDevice.device.press('\x08')
+            elif offset == 2:
+                fgoDevice.device.press('K')
+            elif offset == 3:
+                time.sleep(50)
+                fgoDevice.device.press('J')
+            elif 4 <= offset <= 9:
+                time.sleep(5)
+                # One K press every other frame (~0.2+ sec gap) for 6 rounds
+                if (offset - 4) % 2 == 0:
+                    detect.save(name="FuseBeforePress_" + str(offset - 3))
+                    fgoDevice.device.press('K')
+            elif offset == 10:
+                fgoDevice.device = fgoDevice.Device(fgoDevice.device.name)
+            elif 11 <= offset <= 16:
+                time.sleep(5)
+                # Second phase: BACK + K + J, one key every other frame
+                step = offset - 11
+                detect.save(name="FuseBeforeHandle_" + str(step))
+                if step % 2 == 0:
+                    fgoDevice.device.press('\x08')
+                elif step % 2 == 1:
+                    fgoDevice.device.press('K')
+                elif step % 2 == 0:
+                    fgoDevice.device.press('J')
+            elif offset > 30:
+                detect.save(name="FuseFinal")
+                traceback.print_stack()
+                raise ScriptStop('Fused')
+            # else: offset 17~30 — let detection try to recover naturally
+
